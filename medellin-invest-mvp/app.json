{
  "expo": {
    "name": "Medellín Invest",
    "slug": "medellin-invest-mvp",
    "owner": "appmo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "medellininvest",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medellininvest.mvp"
    },
    "android": {
      "package": "com.medellininvest.mvp",
      "adaptiveIcon": {
        "backgroundColor": "#0E1B2B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/gh/spearisa/expo@preview/medellin-invest-mvp/dist"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/REPLACE_WITH_PROJECT_ID_FROM_EAS_INIT"
    }
  }
}
